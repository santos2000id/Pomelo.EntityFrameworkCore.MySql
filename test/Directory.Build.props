<Project>
  <Import Project="..\Directory.Build.props" />

  <PropertyGroup>
      <NoWarn>$(NoWarn);EF1001;MSB3277;xUnit1000;xUnit1003;xUnit1004;xUnit1010;xUnit1013;xUnit1024;xUnit1026;xUnit1031;xUnit1051;xUnit2013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Using xunit.core and .assert instead of the main package because compilation fails due to warnings triggered by xunit.analyzers. -->
    <!-- <PackageReference Include="xunit" /> -->
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="GitHubActionsTestLogger" />
  </ItemGroup>
</Project>
